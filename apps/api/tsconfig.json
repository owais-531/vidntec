{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "baseUrl": ".",
    "types": ["node"],
    "declaration": false,
    "declarationMap": false,
    "removeComments": true,
    "verbatimModuleSyntax": false,
    "strictPropertyInitialization": false,
    "paths": {
      "@vidntec/shared": ["../../packages/shared/dist/index.d.ts"],
      "@vidntec/shared/password": ["../../packages/shared/dist/password.d.ts"],
      "@vidntec/shared/prisma": ["../../packages/shared/generated/prisma/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test", "**/*.test.ts", "**/*.spec.ts"]
}
