# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT env — copy to .env at the repo root:  cp .env.example .env
#
# This single file feeds both:
#   - the NestJS API   (apps/api, via @nestjs/config)
#   - the Prisma CLI   (packages/shared db:* scripts, via dotenv-cli)
#
# apps/web reads apps/web/.env.local (see apps/web/.env.example).
#
# In PRODUCTION nothing reads this file — set each var as a Railway / Vercel
# environment variable. Per-app var lists: apps/api/.env.example, apps/web/.env.example
# NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# ── Database ────────────────────────────────────────────────────────────────
# Local Postgres from docker-compose.yml. In production this is the Railway
# Postgres connection string.
DATABASE_URL="postgresql://vidntec:vidntec@localhost:5432/vidntec?schema=public"

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate each with:  openssl rand -base64 48   (the two MUST differ)
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
AUTH_COOKIE_DOMAIN=
COOKIE_SECURE=false
# lax for local dev; 'none' in prod when web and api are on different domains
COOKIE_SAMESITE=lax

# ── CORS ───────────────────────────────────────────────────────────────────
WEB_ORIGIN="http://localhost:3000"

# ── Stripe (needed from M6) ────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ── Cloudinary (needed from M3) ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud"
CLOUDINARY_API_KEY="xxx"
CLOUDINARY_API_SECRET="xxx"

# ── Resend (needed from M7) ────────────────────────────────────────────────
RESEND_API_KEY="re_xxx"
EMAIL_FROM="vidntec <orders@example.com>"

# ── Sentry (optional everywhere) ──────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Seed overrides (optional) ─────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=admin123
