# apps/api/.env.example — the full list of variables the API needs.
#
# LOCAL DEV: you don't need this file — put these in the repo-root .env instead
#   (one file feeds both the API and the Prisma CLI). An apps/api/.env, if you
#   create one, overrides the root .env.
# RAILWAY: set every variable below as a service variable (no file).

NODE_ENV=development
PORT=4000

# ── Database (Railway Postgres) ───────────────────────────────────────────────
# On Railway, add this as a reference variable: ${{Postgres.DATABASE_URL}}
# (or DATABASE_PUBLIC_URL if running `prisma migrate`/`db:seed` from your own machine).
DATABASE_URL="postgresql://postgres:password@containers-us-west-1.railway.app:1234/railway"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-48+-random-bytes-base64"
JWT_REFRESH_SECRET="replace-with-a-DIFFERENT-48+-random-bytes-base64"
# Leave unset for localhost. In prod set to the shared parent domain, e.g. ".vidntec.com"
AUTH_COOKIE_DOMAIN=
# false only for local http; true everywhere else
COOKIE_SECURE=false
# lax for local dev; 'none' in prod when web and api are on different domains
COOKIE_SAMESITE=lax

# ── CORS ─────────────────────────────────────────────────────────────────────
WEB_ORIGIN="http://localhost:3000"

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_xxx"
# From `stripe listen` locally, or the dashboard endpoint secret in prod:
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud"
CLOUDINARY_API_KEY="xxx"
CLOUDINARY_API_SECRET="xxx"

# ── Resend ───────────────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxx"
EMAIL_FROM="vidntec <orders@yourdomain.com>"

# ── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
