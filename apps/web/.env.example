# apps/web/.env.example  →  copy to apps/web/.env.local  (never commit .env.local)
# On Vercel these are set as Project Environment Variables.

# Base URL of the NestJS API (Railway).
# Server-side calls:
API_URL="http://localhost:4000"
# Browser-side calls (usually the same value; in prod the public Railway URL):
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Canonical public site URL — drives metadataBase, canonical tags, sitemap, robots,
# JSON-LD and social cards. In prod: https://vidntec.com (no trailing slash).
NEXT_PUBLIC_SITE_URL="https://vidntec.com"

# Must be IDENTICAL to the API's JWT_ACCESS_SECRET. Used only to *verify* access
# tokens in middleware / server components (the web never signs tokens).
JWT_ACCESS_SECRET=""

# ── Sentry ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
# Source-map upload (set in Vercel only, not locally):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
